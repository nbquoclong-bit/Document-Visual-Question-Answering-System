# Khi chạy local, MODEL_DIR và adapter tự suy ra từ thư mục gốc repo.
# Có thể thay VLM_BASE_MODEL bằng đường dẫn snapshot Qwen2-VL đã tải sẵn để chạy offline.
VLM_BASE_MODEL=Qwen/Qwen2-VL-2B-Instruct
VLM_ALLOW_BASE_MODEL=false
# base = JSON một lượt ổn định; single/multi = dùng LoRA để thử nghiệm extraction.
VLM_EXTRACTION_MODE=base

# Tuỳ chọn: dùng SQLite ở vị trí khác.
# DATABASE_URL=sqlite:///./app.db
