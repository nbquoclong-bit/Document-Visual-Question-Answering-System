# ====================================================================
# Git Ignore Configuration for Document VQA System
# ====================================================================

# Python & Caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments & IDE
venv/
env/
ENV/
.env
.venv/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large Archives & Raw Datasets (Do not commit >100MB files to GitHub)
datasets.zip
*.zip
*.tar.gz
*.7z
*.rar
datasets/
data/raw/
data/processed/

# Model Checkpoints & Large Binary Weights
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
!model/stage1_vlm/output/lora_adapters/adapter_config.json
!model/output/qwen2_5_vl_lora_adapters/adapter_config.json

# Temporary Files, Logs & Gradio
*.log
*.tmp
.gradio/
temp_*.jpg
temp_*.png
temp_*.jpeg

# Kaggle Automation Temp Folders
kaggle_automation/*_kernel/
kaggle_automation/live_*/
kaggle_automation/temp_*/
kaggle_automation/fresh_*/
kaggle_automation/base_*/
kaggle_automation/.kaggle/

# Backend Runtime Data
*.db
*.sqlite
*.sqlite3
backend/backend-docvqa/backend/.paddle/
backend/backend-docvqa/backend/uploads/*
!backend/backend-docvqa/backend/uploads/.gitkeep
backend/backend-docvqa/backend/results/*
!backend/backend-docvqa/backend/results/.gitkeep
backend/backend-docvqa/backend/pytest-cache-files-*/

# Node / Frontend
frontend/node_modules/
frontend/dist/
.oxlintrc.json

# Environment / API Configuration
.env.local
.env.*.local
